{
  "version": "1.0",
  "basePath": "/api",
  "routes": [
    { "path": "/settings/public", "methods": ["GET"], "handlerSummary": "Public store settings", "auth": "public", "requestBody": null, "responseStatuses": [200, 500] },
    { "path": "/products", "methods": ["GET"], "handlerSummary": "List product or get by slug", "auth": "public", "requestBody": null, "responseStatuses": [200, 404, 500] },
    { "path": "/orders", "methods": ["GET"], "handlerSummary": "Get order by orderNumber and email (track order)", "auth": "public", "requestBody": null, "responseStatuses": [200, 400, 404, 500] },
    { "path": "/auth/callback", "methods": ["GET"], "handlerSummary": "Supabase auth callback", "auth": "public", "requestBody": null, "responseStatuses": [200, 302, 500] },
    { "path": "/coupons/validate", "methods": ["POST"], "handlerSummary": "Validate coupon code", "auth": "public", "requestBody": { "optional": false, "schemaRef": "ValidateCoupon" }, "responseStatuses": [200, 400, 404] },
    { "path": "/payment/create-order", "methods": ["POST"], "handlerSummary": "Create Razorpay order", "auth": "public", "requestBody": { "optional": false, "schemaRef": "CreateOrder" }, "responseStatuses": [200, 400, 500] },
    { "path": "/payment/verify", "methods": ["POST"], "handlerSummary": "Verify payment and confirm order", "auth": "public", "requestBody": { "optional": false, "schemaRef": "VerifyPayment" }, "responseStatuses": [200, 400, 500] },
    { "path": "/contact", "methods": ["POST"], "handlerSummary": "Submit contact form", "auth": "public", "requestBody": { "optional": false, "schemaRef": "ContactBody" }, "responseStatuses": [200, 400, 500] },
    { "path": "/newsletter", "methods": ["POST"], "handlerSummary": "Newsletter signup", "auth": "public", "requestBody": { "optional": false, "schemaRef": "NewsletterBody" }, "responseStatuses": [200, 400, 500] },
    { "path": "/admin/newsletter", "methods": ["GET"], "handlerSummary": "List newsletter subscribers", "auth": "admin", "requestBody": null, "responseStatuses": [200, 401, 403, 500] },
    { "path": "/admin/pos/complete", "methods": ["POST"], "handlerSummary": "Complete POS sale", "auth": "admin", "requestBody": { "optional": false, "schemaRef": "POSComplete" }, "responseStatuses": [200, 400, 401, 403, 500] },
    { "path": "/admin/reviews/:id", "methods": ["PATCH"], "handlerSummary": "Update review approval", "auth": "admin", "requestBody": { "optional": false, "schemaRef": "ReviewPatch" }, "responseStatuses": [200, 401, 403, 404, 500] },
    { "path": "/admin/reviews", "methods": ["GET"], "handlerSummary": "List reviews", "auth": "admin", "requestBody": null, "responseStatuses": [200, 401, 403, 500] },
    { "path": "/admin/contacts", "methods": ["GET", "PATCH"], "handlerSummary": "List/update contact messages", "auth": "admin", "requestBody": null, "responseStatuses": [200, 401, 403, 500] },
    { "path": "/admin/settings", "methods": ["GET", "PUT"], "handlerSummary": "Get/update store settings", "auth": "admin", "requestBody": { "optional": true, "schemaRef": "SettingsPut" }, "responseStatuses": [200, 401, 403, 500] },
    { "path": "/admin/customers", "methods": ["GET"], "handlerSummary": "List customers", "auth": "admin", "requestBody": null, "responseStatuses": [200, 401, 403, 500] },
    { "path": "/admin/coupons/:id", "methods": ["GET", "PUT", "DELETE"], "handlerSummary": "Get/update/delete coupon", "auth": "admin", "requestBody": { "optional": true, "schemaRef": "CouponBody" }, "responseStatuses": [200, 400, 401, 403, 404, 500] },
    { "path": "/admin/coupons", "methods": ["GET", "POST"], "handlerSummary": "List/create coupons", "auth": "admin", "requestBody": { "optional": false, "schemaRef": "CouponBody" }, "responseStatuses": [200, 201, 400, 401, 403, 500] },
    { "path": "/admin/inventory", "methods": ["GET", "POST"], "handlerSummary": "List inventory / adjust stock", "auth": "admin", "requestBody": { "optional": true, "schemaRef": "InventoryAdjust" }, "responseStatuses": [200, 400, 401, 403, 500] },
    { "path": "/admin/orders/:id", "methods": ["GET", "PATCH"], "handlerSummary": "Get/update order", "auth": "admin", "requestBody": { "optional": true, "schemaRef": "OrderPatch" }, "responseStatuses": [200, 401, 403, 404, 500] },
    { "path": "/admin/orders", "methods": ["GET"], "handlerSummary": "List orders", "auth": "admin", "requestBody": null, "responseStatuses": [200, 401, 403, 500] },
    { "path": "/admin/categories/:id", "methods": ["PUT", "DELETE"], "handlerSummary": "Update/delete category", "auth": "admin", "requestBody": { "optional": true, "schemaRef": "CategoryBody" }, "responseStatuses": [200, 400, 401, 403, 404, 500] },
    { "path": "/admin/categories", "methods": ["GET", "POST"], "handlerSummary": "List/create categories", "auth": "admin", "requestBody": { "optional": false, "schemaRef": "CategoryBody" }, "responseStatuses": [200, 201, 400, 401, 403, 500] },
    { "path": "/admin/products/:id", "methods": ["GET", "PUT", "DELETE"], "handlerSummary": "Get/update/delete product", "auth": "admin", "requestBody": { "optional": true, "schemaRef": "ProductBody" }, "responseStatuses": [200, 400, 401, 403, 404, 500] },
    { "path": "/admin/products", "methods": ["GET", "POST"], "handlerSummary": "List/create products", "auth": "admin", "requestBody": { "optional": false, "schemaRef": "ProductBody" }, "responseStatuses": [200, 201, 400, 401, 403, 500] },
    { "path": "/admin/products/:id/images", "methods": ["GET", "POST", "PATCH", "DELETE"], "handlerSummary": "Product images CRUD", "auth": "admin", "requestBody": { "optional": true, "schemaRef": "ProductImageBody" }, "responseStatuses": [200, 400, 401, 403, 404, 500] },
    { "path": "/admin/upload", "methods": ["POST"], "handlerSummary": "Upload file to R2", "auth": "admin", "requestBody": { "optional": false, "description": "multipart/form-data with file" }, "responseStatuses": [200, 400, 401, 403, 500] },
    { "path": "/admin/product-images/:id/primary", "methods": ["PATCH"], "handlerSummary": "Set product image as primary", "auth": "admin", "requestBody": null, "responseStatuses": [200, 401, 403, 404, 500] }
  ],
  "schemas": {
    "ValidateCoupon": { "type": "object", "properties": { "code": { "type": "string" }, "amount": { "type": "number" } } },
    "CreateOrder": { "type": "object", "properties": { "items": { "type": "array" }, "shippingAddress": { "type": "object" }, "couponCode": { "type": "string" }, "guestEmail": { "type": "string" }, "guestPhone": { "type": "string" } } },
    "VerifyPayment": { "type": "object", "properties": { "razorpay_order_id": { "type": "string" }, "razorpay_payment_id": { "type": "string" }, "razorpay_signature": { "type": "string" } } },
    "ContactBody": { "type": "object", "properties": { "name": { "type": "string" }, "email": { "type": "string" }, "subject": { "type": "string" }, "message": { "type": "string" } } },
    "NewsletterBody": { "type": "object", "properties": { "email": { "type": "string" } } },
    "POSComplete": { "type": "object", "properties": { "items": { "type": "array" }, "customer": { "type": "object" }, "payment": { "type": "object" } } },
    "ReviewPatch": { "type": "object", "properties": { "is_approved": { "type": "boolean" } } },
    "SettingsPut": { "type": "object", "description": "key-value settings" },
    "CouponBody": { "type": "object", "properties": { "code": { "type": "string" }, "type": { "type": "string" }, "value": { "type": "number" }, "min_order_value": { "type": "number" }, "usage_limit": { "type": "number" }, "expires_at": { "type": "string" }, "is_active": { "type": "boolean" } } },
    "InventoryAdjust": { "type": "object", "properties": { "variant_id": { "type": "string" }, "type": { "type": "string" }, "quantity_change": { "type": "number" }, "note": { "type": "string" } } },
    "OrderPatch": { "type": "object", "properties": { "status": { "type": "string" }, "admin_notes": { "type": "string" } } },
    "CategoryBody": { "type": "object", "properties": { "name": { "type": "string" }, "slug": { "type": "string" }, "description": { "type": "string" }, "sort_order": { "type": "number" }, "is_active": { "type": "boolean" } } },
    "ProductBody": { "type": "object", "properties": { "name": { "type": "string" }, "slug": { "type": "string" }, "variants": { "type": "array" }, "category_ids": { "type": "array" }, "image_urls": { "type": "array" } } },
    "ProductImageBody": { "type": "object", "properties": { "url": { "type": "string" }, "sort_order": { "type": "number" }, "is_primary": { "type": "boolean" } } }
  }
}
