{
  "version": "1.0",
  "layouts": ["storefront", "admin"],
  "pages": [
    { "path": "/", "layout": "storefront", "apiCalls": ["POST /api/newsletter"], "description": "Homepage (NewsletterSection)" },
    { "path": "/products", "layout": "storefront", "apiCalls": [], "description": "Products listing (server data)" },
    { "path": "/product/:slug", "layout": "storefront", "apiCalls": [], "description": "Product detail (server data)" },
    { "path": "/collections", "layout": "storefront", "apiCalls": [], "description": "Collections" },
    { "path": "/collections/:slug", "layout": "storefront", "apiCalls": [], "description": "Collection detail" },
    { "path": "/fragrance-finder", "layout": "storefront", "apiCalls": [], "description": "Fragrance finder" },
    { "path": "/checkout", "layout": "storefront", "apiCalls": ["POST /api/coupons/validate", "POST /api/payment/create-order", "POST /api/payment/verify"], "description": "Checkout" },
    { "path": "/track-order", "layout": "storefront", "apiCalls": ["GET /api/orders"], "description": "Track order" },
    { "path": "/order-success", "layout": "storefront", "apiCalls": [], "description": "Order success" },
    { "path": "/contact", "layout": "storefront", "apiCalls": ["POST /api/contact"], "description": "Contact form" },
    { "path": "/about", "layout": "storefront", "apiCalls": [], "description": "About" },
    { "path": "/faq", "layout": "storefront", "apiCalls": [], "description": "FAQ" },
    { "path": "/shipping", "layout": "storefront", "apiCalls": [], "description": "Shipping info" },
    { "path": "/returns", "layout": "storefront", "apiCalls": [], "description": "Returns" },
    { "path": "/login", "layout": "storefront", "apiCalls": [], "description": "Login" },
    { "path": "/signup", "layout": "storefront", "apiCalls": [], "description": "Signup" },
    { "path": "/account", "layout": "storefront", "apiCalls": [], "description": "Account" },
    { "path": "/account/orders", "layout": "storefront", "apiCalls": [], "description": "Account orders" },
    { "path": "/account/profile", "layout": "storefront", "apiCalls": [], "description": "Account profile" },
    { "path": "/admin", "layout": "admin", "apiCalls": [], "description": "Admin dashboard (server data)" },
    { "path": "/admin/products", "layout": "admin", "apiCalls": ["GET /api/admin/products", "DELETE /api/admin/products/:id"], "description": "Products list" },
    { "path": "/admin/products/new", "layout": "admin", "apiCalls": ["GET /api/admin/categories", "POST /api/admin/upload", "POST /api/admin/products"], "description": "Add product (ProductForm)" },
    { "path": "/admin/products/:id", "layout": "admin", "apiCalls": ["GET /api/admin/products/:id", "GET /api/admin/categories", "POST /api/admin/upload", "PUT /api/admin/products/:id", "DELETE /api/admin/products/:id"], "description": "Edit product (ProductForm)" },
    { "path": "/admin/categories", "layout": "admin", "apiCalls": ["GET /api/admin/categories", "POST /api/admin/categories", "PUT /api/admin/categories/:id", "DELETE /api/admin/categories/:id"], "description": "Categories" },
    { "path": "/admin/orders", "layout": "admin", "apiCalls": ["GET /api/admin/orders"], "description": "Orders list" },
    { "path": "/admin/orders/:id", "layout": "admin", "apiCalls": ["GET /api/admin/orders/:id", "PATCH /api/admin/orders/:id"], "description": "Order detail" },
    { "path": "/admin/inventory", "layout": "admin", "apiCalls": ["GET /api/admin/inventory", "POST /api/admin/inventory"], "description": "Inventory" },
    { "path": "/admin/coupons", "layout": "admin", "apiCalls": ["GET /api/admin/coupons", "POST /api/admin/coupons", "PUT /api/admin/coupons/:id", "DELETE /api/admin/coupons/:id"], "description": "Coupons" },
    { "path": "/admin/customers", "layout": "admin", "apiCalls": ["GET /api/admin/customers"], "description": "Customers" },
    { "path": "/admin/pos", "layout": "admin", "apiCalls": ["GET /api/admin/products", "POST /api/admin/pos/complete"], "description": "POS" },
    { "path": "/admin/analytics", "layout": "admin", "apiCalls": ["GET /api/admin/orders"], "description": "Analytics" },
    { "path": "/admin/settings", "layout": "admin", "apiCalls": ["GET /api/admin/settings", "PUT /api/admin/settings"], "description": "Settings" },
    { "path": "/admin/contacts", "layout": "admin", "apiCalls": ["GET /api/admin/contacts", "PATCH /api/admin/contacts"], "description": "Contacts" },
    { "path": "/admin/reviews", "layout": "admin", "apiCalls": ["GET /api/admin/reviews", "PATCH /api/admin/reviews/:id"], "description": "Reviews" },
    { "path": "/admin/newsletter", "layout": "admin", "apiCalls": ["GET /api/admin/newsletter"], "description": "Newsletter subscribers" }
  ]
}
