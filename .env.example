# ===========================================
# URsignature Environment Variables
# Copy to .env.local and fill values
# ===========================================

# Supabase (required) - Get from supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Razorpay (required for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudflare R2 (required for image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ursignature-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.ursignature.com

# Telegram (for order alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shiprocket (for shipping)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Analytics (optional)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# App Config
NEXT_PUBLIC_APP_URL=https://ursignature.com
NEXT_PUBLIC_APP_NAME=URsignature
CRON_SECRET=generate_random_32_char_string
